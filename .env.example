APP_ENV=development
APP_URL=http://localhost:8888/dolof
# Default site / browser title (admin Event title overrides when set)
APP_TITLE=Deacons Ordination Lunch Ordering Form

reply_to=cd@crosspointchurchsv.org
return_path=cd@crosspointchurchsv.org
cc=cd@crosspointchurchsv.org

DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=crossp11_db1
DB_USER=root
DB_PASSWORD=your_password

DOLOS_DEFAULT_BOX_PRICE=15
DOLOS_DEFAULT_BOX_CAP=100
DOLOS_MAX_QTY_PER_BOX=10
DOLOS_LOW_STOCK_THRESHOLD=30
HOLD_MINUTES=35

# Order form: show "留位但不點餐" lunch option (0=hidden, 1=shown)
SHOW_NOT_ORDERING=0

# Ordering window (America/Los_Angeles / Pacific Time)
ORDERING_START=2026-09-20 14:00:00
ORDERING_END=2026-11-01 23:50:00

StripePublicKey=pk_test_xxx
StripeSecretKey=sk_test_xxx
StripeWebhookSecret=whsec_xxx

GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
ADMIN_WHITELIST=you@example.org,other@example.org
